{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "role_title": {
      "type": "string",
      "description": "Role the person applied for"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string",
      "description": "Profile or portfolio link"
    },
    "message": {
      "type": "string",
      "description": "Why they want to join and what they bring"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "interview",
        "closed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "gray"
      ],
      "default": "new"
    },
    "consent": {
      "type": "boolean",
      "description": "Applicant agreed we may store their details"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}